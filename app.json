{
  "expo": {
    "name": "Quikli",
    "slug": "quikli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/forgotSomethingLogo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/forgotSomethingLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gurungnavin.quikli",
      "infoPlist": {
        "GADApplicationIdentifier": "ca-app-pub-1244917734079996~4051517495",
        "SKAdNetworkItems": [
          { "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork" }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/quikli-red.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gurungnavin.quikli"
    },
    "web": {
      "favicon": "./assets/forgotSomethingLogo.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-1244917734079996~4051517495"
        }
      ]
    ]
  }
}